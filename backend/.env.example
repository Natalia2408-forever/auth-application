PORT=3005

# PostgreSQL (the database must already exist, e.g. createdb auth_app locally,
# or create one in the dashboard of a hosted provider like Neon)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_DATABASE=auth_app
# SSL is enabled by default (needed for Neon, Render, Supabase...).
# Uncomment and set to false only for a local Postgres without SSL.
# DB_SSL=false

# JWT - use long random strings, e.g.
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_KEY=your_jwt_secret
JWT_REFRESH_KEY=your_jwt_refresh_secret

# URLs
# CORS origin: scheme + host (+ port) only, no path, no trailing slash
CLIENT_HOST=http://localhost:5173
# Where the user is redirected after OAuth. Include the base path if the app is
# served from a subpath, no trailing slash
# (GitHub Pages: https://<user>.github.io/auth-application)
CLIENT_APP_URL=http://localhost:5173
# Public URL of THIS API, used to build OAuth callback URLs
API_HOST=http://localhost:3005

# OAuth (optional). A provider without keys is disabled.
# Register these callback URLs: {API_HOST}/auth/google/callback,
# {API_HOST}/auth/facebook/callback, {API_HOST}/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

